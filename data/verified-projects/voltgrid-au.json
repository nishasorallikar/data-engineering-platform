  "scenarios": [
    {
      "layer": "Bronze",
      "scenario": "Raw IoT telemetry preserved for replay",
      "handling": "Append-only Delta; never modified"
    },
    {
      "layer": "Bronze",
      "scenario": "Corrupt / malformed JSON",
      "handling": "_is_corrupt = TRUE; quarantine"
    },
    {
      "layer": "Bronze",
      "scenario": "Non-standard XML encoding",
      "handling": "ADF XML connector; stored as raw JSON"
    },
    {
      "layer": "Bronze",
      "scenario": "PDF invoice arrives by email",
      "handling": "Logic Apps → Blob → extracted JSON"
    },
    {
      "layer": "Bronze",
      "scenario": "API schema drift",
      "handling": "Auto Loader schema evolution"
    },
    {
      "layer": "Bronze",
      "scenario": "Duplicate IoT resend",
      "handling": "Stored as-is; dedup happens in Silver"
    },
    {
      "layer": "Bronze",
      "scenario": "Late-arriving batch file",
      "handling": "Partition by source date, not load date"
    },
    {
      "layer": "Bronze",
      "scenario": "Restricted card data",
      "handling": "Separate path + RBAC"
    },
    {
      "layer": "Bronze",
      "scenario": "Pipeline audit trail",
      "handling": "Ingestion timestamp, source and run ID metadata"
    },
    {
      "layer": "Silver",
      "scenario": "Duplicate telemetry",
      "handling": "Dedup on charger_id + event_ts + connector_id; keep latest",
      "codeSnippet": {
        "language": "sql",
        "code": "MERGE INTO silver.telemetry AS target\nUSING (\n  SELECT * FROM bronze.telemetry \n  QUALIFY ROW_NUMBER() OVER (PARTITION BY charger_id, event_ts ORDER BY load_time DESC) = 1\n) AS source\nON target.charger_id = source.charger_id AND target.event_ts = source.event_ts\nWHEN NOT MATCHED THEN INSERT *;"
      }
    },
    {
      "layer": "Silver",
      "scenario": "12-minute-late event",
      "handling": "Quarantine beyond 10-minute watermark",
      "codeSnippet": {
        "language": "python",
        "code": "streaming_df.withWatermark(\"event_timestamp\", \"10 minutes\") \\\n  .groupBy(window(\"event_timestamp\", \"5 minutes\"), \"charger_id\") \\\n  .count()"
      }
    },
    {
      "layer": "Silver",
      "scenario": "OVERTEMP fault",
      "handling": "Map to Overheating Risk and set overheating flag"
    },
    {
      "layer": "Silver",
      "scenario": "82°C charger",
      "handling": "Overheating flag + maintenance event"
    },
    {
      "layer": "Silver",
      "scenario": "Raw card number",
      "handling": "PAN masked; CVV discarded; token retained"
    },
    {
      "layer": "Silver",
      "scenario": "AEST timestamp",
      "handling": "Convert to UTC; retain reporting equivalent"
    },
    {
      "layer": "Silver",
      "scenario": "Tariff rate changed",
      "handling": "Close old SCD2 row and open new row",
      "codeSnippet": {
        "language": "sql",
        "code": "-- SCD Type 2 Update\nUPDATE silver.dim_tariff\nSET is_current = FALSE, valid_to = CURRENT_TIMESTAMP()\nWHERE tariff_id = source.tariff_id AND is_current = TRUE;"
      }
    },
    {
      "layer": "Silver",
      "scenario": "P1 complaint >4 hours",
      "handling": "SLA breach derived"
    },
    {
      "layer": "Silver",
