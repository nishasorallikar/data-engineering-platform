  "ingestion": [
    "Streaming Path: IoT Chargers (OCPP) → Azure IoT Hub → Azure Event Hubs → Databricks Structured Streaming → Bronze Delta.",
    "Batch Path: CSV / XML files → ADF Copy Activity → ADLS Bronze; REST APIs → ADF REST Connector → ADLS Bronze JSON.",
    "PDF Invoice Path: Email attachment → Logic Apps → Blob Storage → Azure AI Document Intelligence → ADLS Bronze JSON.",
    "CDC Path (future / RDBMS): ADF CDC connector or Debezium → Event Hub → Bronze.",
    "Patterns: High-watermark incremental load, Exactly-once streaming, Schema evolution, Retry + exponential backoff, Quarantine routing."
  ],
  "processing": [
    "Bronze Layer: Immutable raw replica of every source record. No transformations. Delta Lake format. Source-date partitioning. 90 days retention.",
    "Silver Layer: Cleansed & Standardised. Validated and deduplicated data. Idempotent MERGE / upsert. SCD Type 2 handling. Fault Code Mapping. GST Split."
  ],
  "storage": [
    "ADLS Gen2 — BRONZE (Raw Delta)",
    "ADLS Gen2 — SILVER (Cleansed / Standardised Delta)",
    "ADLS Gen2 — GOLD (Business Curated)"
  ],
  "serving": [
    "Azure Synapse Analytics (External tables, Serverless SQL, Dedicated SQL pool)",
    "Power BI (DirectQuery and Import mode, 14 dashboard views, RLS)",
    "Azure Cosmos DB + APIs (Low-latency operational reads, fleet web/mobile APIs)"
  ],
  "dataQuality": [
    "Bronze → Silver: Schema check, Null check, Duplicate check, Range check, Referential check, Freshness check, Business rule.",
    "Silver → Gold: Reconciliation check, SCD2 continuity check, Aggregation sanity check, Rejected records quarantine, DQ metrics audit table."
  ],
  "security": [
    "Microsoft Entra ID for identities.",
    "Managed Identity for service-to-service authentication.",
    "Azure RBAC on ADLS containers.",
    "Azure Key Vault stores API keys, DB connection strings and storage secrets.",
    "Customer email is hashed in Silver/Gold. Card PAN is masked. CVV is discarded.",
    "ADLS Gen2 platform encryption. HTTPS / TLS 1.2+ enforced.",
    "Power BI / Synapse row-level security (Executive, State Manager, Franchise Owner)."
  ],
  "orchestration": [
    "Azure Data Factory (Parameterised pipelines, Azure SQL watermark table, Pipeline audit).",
    "Databricks Jobs (Bronze → Silver domain jobs, Silver → Gold DLT/notebook clusters, Always-on streaming jobs).",
    "Azure DevOps CI/CD (Dev → QA → UAT → Prod. PR gate: linting, unit tests, DQ checks)."
  ],
  "monitoring": [
    "Azure Monitor + Log Analytics (ADF pipeline failures, Data volume anomaly)",
    "Databricks metrics (Streaming lag > 5 min)",
    "Custom DQ audit table (Data freshness - No new rows in last 2 hours)",
    "Databricks streaming alert (Charger overheating >75°C, Payment failure spike >10% in 5-min window)",
    "Logic App timer (Pipeline SLA breach)",
    "Azure Cost Management (Storage cost)",
    "Synapse / Power BI (Query performance >30 seconds)"
  ],
